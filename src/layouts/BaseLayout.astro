---
import SEO from "../components/SEO.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
}

const {
  title = "Partner Revenue Labs",
  description = "Revenue-focused guides and tools for ecommerce brands using AI in ads and analytics.",
  canonical = "https://partner-revenue-labs.pages.dev/",
  ogImage,
  schema,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">
          <span class="logo-badge">PRL</span>
          <div class="logo-text">
            <div class="logo-line">PARTNER REVENUE</div>
            <div class="logo-sub">LABS</div>
          </div>
        </a>
        <nav class="nav">
          <a href="/services">Capabilities</a>
          <a href="/#tech">Telemetry <span class="nav-badge">Sample</span></a>
          <a href="/blog">Playbooks</a>
          <a href="/#calculator">MER Model</a>
          <a href="/about">About</a>
        </nav>
      </div>
      <div class="header-actions">
        <a href="/contact" class="client-portal-link">Contact</a>
        <a href="#" data-open-modal="qual" class="header-cta">
          <span>Request 48h Audit</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </header>

    <!-- Dual B2B Modal: Open-source 15-min Scheduler + 48h Brand Qual Audit -->
    <div id="dual-modal" class="dual-modal hidden">
      <div class="dual-modal-card">
        <div class="dual-modal-header">
          <div class="dual-modal-brand">
            <div class="dual-badge">PRL</div>
            <div class="dual-brand-text">
              <span class="dual-brand-line">Partner Revenue</span>
              <span class="dual-brand-sub">LABS</span>
            </div>
          </div>
          <button id="dual-modal-close" class="dual-modal-close">✕</button>
        </div>

        <div class="dual-modal-tabs">
          <button type="button" id="modal-tab-call" class="dual-tab dual-tab--active">
            <svg class="dual-tab-icon dual-tab-icon--call" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>15-Min Strategy Call</span>
          </button>
          <button type="button" id="modal-tab-qual" class="dual-tab">
            <svg class="dual-tab-icon dual-tab-icon--qual" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>48h Brand Qual Audit</span>
          </button>
        </div>

        <!-- TAB 1: 15-minute strategy call scheduler -->
        <div id="modal-content-call" class="dual-tab-panel dual-tab-panel--active">
          <div class="dual-host-banner">
            <div class="dual-host-info">
              <div class="dual-host-avatar">PRL</div>
              <div>
                <div class="dual-host-name">Partner Revenue Labs · Growth Architecture</div>
                <div class="dual-host-role">15 min · Unit Economics &amp; Channel Fit · Video Call</div>
              </div>
            </div>
            <span class="dual-host-pill">● Discovery Open</span>
          </div>

          <div class="dual-form-group">
            <label class="dual-form-label">Primary Growth Objective</label>
            <div class="dual-topic-grid">
              <label class="dual-topic dual-topic--active">
                <input type="radio" name="call-topic" value="Affiliate & Creator Scale" checked />
                <span>Creator &amp; Affiliate</span>
              </label>
              <label class="dual-topic">
                <input type="radio" name="call-topic" value="MER & Attribution" />
                <span>MER &amp; Attribution</span>
              </label>
              <label class="dual-topic">
                <input type="radio" name="call-topic" value="Omnichannel & Retail" />
                <span>Omnichannel Retainers</span>
              </label>
            </div>
          </div>

          <div class="dual-form-group">
            <div class="dual-slot-label-row">
              <label class="dual-form-label">Select Date &amp; Time Slot (Pacific Time)</label>
              <span class="dual-slot-tag">⚡ Instant Confirmation</span>
            </div>
            <div class="dual-slots" id="slots-container">
              <button type="button" data-slot-date="Tomorrow" data-slot-time="10:00 AM" class="dual-slot dual-slot--selected">
                <div>Tomorrow</div>
                <div class="dual-slot-time">10:00 AM</div>
              </button>
              <button type="button" data-slot-date="Tomorrow" data-slot-time="2:30 PM" class="dual-slot">
                <div>Tomorrow</div>
                <div class="dual-slot-time">2:30 PM</div>
              </button>
              <button type="button" data-slot-date="Friday" data-slot-time="11:15 AM" class="dual-slot">
                <div>Friday</div>
                <div class="dual-slot-time">11:15 AM</div>
              </button>
              <button type="button" data-slot-date="Friday" data-slot-time="4:00 PM" class="dual-slot">
                <div>Friday</div>
                <div class="dual-slot-time">4:00 PM</div>
              </button>
            </div>
          </div>

          <form class="dual-form" id="booking-form">
            <input type="hidden" id="selected-date" value="Tomorrow" />
            <input type="hidden" id="selected-time" value="10:00 AM" />

            <div class="dual-form-row">
              <div class="dual-form-field">
                <label class="dual-form-label">Your Name</label>
                <input type="text" id="call-name" required placeholder="Jordan Blake" autocomplete="name" />
              </div>
              <div class="dual-form-field">
                <label class="dual-form-label">Work Email</label>
                <input type="email" id="call-email" required placeholder="jordan@brand.com" autocomplete="email" />
              </div>
            </div>

            <div class="dual-form-field">
              <label class="dual-form-label">Brand URL (Optional)</label>
              <input type="text" id="call-brand" placeholder="https://yourbrand.com" autocomplete="url" />
            </div>

            <button type="submit" id="call-submit-btn" class="dual-btn dual-btn--primary">
              <span>Confirm 15-Minute Strategy Session</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </button>
          </form>

          <div id="call-success" class="dual-success hidden">
            <div class="dual-success-head">
              <svg class="dual-success-icon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Time Slot Selected: <span id="conf-slot">Tomorrow at 10:00 AM</span></span>
            </div>
            <p class="dual-success-note">Save this session to your calendar below, and we'll follow up by email with a private meeting link.</p>
            <div class="dual-success-links">
              <a id="gcal-link" href="#" target="_blank" class="dual-success-link">Add to Google Calendar</a>
              <a id="ics-link" href="#" download="prl-strategy-session.ics" class="dual-success-link">Download .ICS (Apple/Outlook)</a>
            </div>
            <p class="dual-success-foot">15-minute discovery · No pressure, no hard pitch.</p>
          </div>
        </div>

        <!-- TAB 2: 48-hour brand qualification audit -->
        <div id="modal-content-qual" class="dual-tab-panel hidden">
          <div class="dual-qual-intro">
            <h4 class="dual-qual-title">Request 48-Hour Funnel &amp; Incrementality Audit</h4>
            <p class="dual-qual-sub">We benchmark your contribution margin, PDP conversion friction, CAPI signal quality, and top 1–2 acquisition levers before recommending spend.</p>
          </div>

          <form class="dual-form" id="qual-form">
            <div class="dual-form-field">
              <label class="dual-form-label">Current Monthly Gross Revenue (GMV)</label>
              <select id="qual-rev" class="dual-input">
                <option>Under $50k / month (Early Validation)</option>
                <option selected>$50k - $250k / month (Emerging DTC / Retail)</option>
                <option>$250k - $1M+ / month (Omnichannel Scale)</option>
              </select>
            </div>

            <div class="dual-form-row">
              <div class="dual-form-field">
                <label class="dual-form-label">Full Name</label>
                <input type="text" id="qual-name" required placeholder="Jordan Blake" autocomplete="name" />
              </div>
              <div class="dual-form-field">
                <label class="dual-form-label">Work Email</label>
                <input type="email" id="qual-email" required placeholder="jordan@brand.com" autocomplete="email" />
              </div>
            </div>

            <div class="dual-form-field">
              <label class="dual-form-label">Storefront or Brand URL</label>
              <input type="text" id="qual-brand" required placeholder="https://yourbrand.com" autocomplete="url" />
            </div>

            <div class="dual-form-field">
              <label class="dual-form-label">Primary Acquisition Bottleneck</label>
              <select id="qual-bottleneck" class="dual-input">
                <option selected>Rising paid social CAC — need incremental creator &amp; affiliate demand</option>
                <option>Low PDP conversion rate or thin contribution margin blocking scale</option>
                <option>Signal loss &amp; broken CAPI / multi-touch attribution</option>
                <option>Brick-and-mortar retailer expanding into marketplaces &amp; live commerce</option>
              </select>
            </div>

            <button type="submit" id="qual-submit-btn" class="dual-btn dual-btn--sage">
              <span>Request 48-Hour Diagnostic Audit</span>
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </form>

          <div id="qual-success" class="dual-success hidden">
            ✓ Audit request received. We'll review your storefront, channel readiness, and likely bottlenecks and follow up within 48 hours.
          </div>

          <div class="dual-qual-foot">
            <span class="dual-qual-foot-item"><svg width="13" height="13" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
            Reviewed directly by our team</span>
            <span class="dual-qual-foot-item">No obligation · No spam</span>
          </div>
        </div>

      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>&copy; {new Date().getFullYear()} Partner Revenue Labs. All rights reserved.</p>
        <div class="footer-links">
          <a href="/services">Capabilities</a>
          <a href="/blog">Playbooks</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
      </div>
    </footer>
    <script>
      // Dual B2B Modal: Open-source 15-min scheduler + 48h brand qual audit
      (function () {
        function el<E extends HTMLElement = HTMLElement>(id: string): E | null {
          return document.getElementById(id) as E | null;
        }
        function input(id: string): HTMLInputElement | null {
          return el<HTMLInputElement>(id);
        }
        function select(id: string): HTMLSelectElement | null {
          return el<HTMLSelectElement>(id);
        }

        function openDualModal(tab?: string) {
          const modal = el('dual-modal');
          if (modal) {
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          }
          switchModalTab(tab || 'call');
        }

        function closeDualModal() {
          const modal = el('dual-modal');
          if (modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        function switchModalTab(tab: string) {
          const tabCallBtn = el('modal-tab-call');
          const tabQualBtn = el('modal-tab-qual');
          const contentCall = el('modal-content-call');
          const contentQual = el('modal-content-qual');
          if (!tabCallBtn || !tabQualBtn || !contentCall || !contentQual) return;

          if (tab === 'call') {
            tabCallBtn.classList.add('dual-tab--active');
            tabQualBtn.classList.remove('dual-tab--active');
            contentCall.classList.add('dual-tab-panel--active');
            contentQual.classList.remove('dual-tab-panel--active');
          } else {
            tabQualBtn.classList.add('dual-tab--active');
            tabCallBtn.classList.remove('dual-tab--active');
            contentQual.classList.add('dual-tab-panel--active');
            contentCall.classList.remove('dual-tab-panel--active');
          }
        }

        function selectSlot(btn: HTMLElement, date: string, time: string) {
          document.querySelectorAll('.dual-slot').forEach(function (b) {
            b.classList.remove('dual-slot--selected');
          });
          btn.classList.add('dual-slot--selected');
          const selectedDate = input('selected-date');
          const selectedTime = input('selected-time');
          if (selectedDate) selectedDate.value = date;
          if (selectedTime) selectedTime.value = time;
        }

        async function handleCallSubmit(e: Event) {
          e.preventDefault();
          const btn = el<HTMLButtonElement>('call-submit-btn');
          const btnText = btn ? btn.querySelector('span') : null;
          if (btn) btn.disabled = true;
          if (btnText) btnText.textContent = 'Scheduling...';

          const nameEl = input('call-name');
          const emailEl = input('call-email');
          const brandEl = input('call-brand');
          const dateEl = input('selected-date');
          const timeEl = input('selected-time');
          const topicEl = document.querySelector<HTMLInputElement>('input[name="call-topic"]:checked');

          const payload = {
            name: nameEl ? nameEl.value : '',
            email: emailEl ? emailEl.value : '',
            brandUrl: brandEl ? brandEl.value : '',
            dateStr: dateEl ? dateEl.value : '',
            timeStr: timeEl ? timeEl.value : '',
            topic: topicEl ? topicEl.value : 'Affiliate Scale',
            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
          };

          let gcalUrl =
            'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' +
            encodeURIComponent('PRL Discovery: ' + payload.name) +
            '&details=' + encodeURIComponent('15-Min Strategy Session') +
            '&location=https://meet.google.com/prl-discovery';

          try {
            const res = await fetch('/api/book', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const result: any = res.ok ? await res.json() : null;
            if (result && result.booking && result.booking.gcalUrl) {
              gcalUrl = result.booking.gcalUrl;
            }
            if (result && result.booking && result.booking.icsDataUri) {
              const icsLink = el<HTMLAnchorElement>('ics-link');
              if (icsLink) icsLink.href = result.booking.icsDataUri;
            }
          } catch (err) {
            // Fallback: static preview without backend
          }

          const gcalLink = el<HTMLAnchorElement>('gcal-link');
          if (gcalLink) gcalLink.href = gcalUrl;
          const confSlot = el('conf-slot');
          if (confSlot) confSlot.textContent = payload.dateStr + ' at ' + payload.timeStr;
          const bookingForm = el('booking-form');
          if (bookingForm) bookingForm.classList.add('hidden');
          const callSuccess = el('call-success');
          if (callSuccess) callSuccess.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Confirmed! ✓';
          if (btn) {
            btn.classList.remove('dual-btn--primary');
            btn.style.background = 'var(--accent)';
          }
        }

        async function handleQualSubmit(e: Event) {
          e.preventDefault();
          const btn = el<HTMLButtonElement>('qual-submit-btn');
          const btnText = btn ? btn.querySelector('span') : null;
          if (btn) btn.disabled = true;
          if (btnText) btnText.textContent = 'Analyzing Brand...';

          const nameEl = input('qual-name');
          const emailEl = input('qual-email');
          const brandEl = input('qual-brand');
          const revEl = select('qual-rev');
          const bottleneckEl = select('qual-bottleneck');

          const payload = {
            name: nameEl ? nameEl.value : '',
            email: emailEl ? emailEl.value : '',
            brandUrl: brandEl ? brandEl.value : '',
            revenueTier: revEl ? revEl.value : '',
            bottleneck: bottleneckEl ? bottleneckEl.value : '',
          };

          try {
            await fetch('/api/qual', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          } catch (err) {
            // Continue to show success in demo/static mode
          }

          const qualForm = el('qual-form');
          if (qualForm) qualForm.classList.add('hidden');
          const qualSuccess = el('qual-success');
          if (qualSuccess) qualSuccess.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Audit Request Received ✓';
        }

        // Topic selector visuals
        document.querySelectorAll('.dual-topic').forEach(function (topic) {
          topic.addEventListener('click', function () {
            document.querySelectorAll('.dual-topic').forEach(function (t) {
              t.classList.remove('dual-topic--active');
            });
            topic.classList.add('dual-topic--active');
          });
        });

        // Modal triggers (all pages)
        document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach(function (trigger) {
          trigger.addEventListener('click', function (e) {
            e.preventDefault();
            openDualModal(trigger.getAttribute('data-open-modal') || 'call');
          });
        });

        // Slot selection
        document.querySelectorAll<HTMLElement>('.dual-slot').forEach(function (slot) {
          slot.addEventListener('click', function () {
            selectSlot(slot, slot.getAttribute('data-slot-date') || '', slot.getAttribute('data-slot-time') || '');
          });
        });

        // Form submissions + close button
        el('dual-modal-close')?.addEventListener('click', function () {
          closeDualModal();
        });
        el('modal-tab-call')?.addEventListener('click', function () {
          switchModalTab('call');
        });
        el('modal-tab-qual')?.addEventListener('click', function () {
          switchModalTab('qual');
        });
        el('booking-form')?.addEventListener('submit', handleCallSubmit);
        el('qual-form')?.addEventListener('submit', handleQualSubmit);

        // Close modal on background click
        const modal = el('dual-modal');
        if (modal) {
          modal.addEventListener('click', function (e) {
            if (e.target === modal) closeDualModal();
          });
        }

        // Close on Escape
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeDualModal();
        });

      })();
    </script>
  </body>
</html>

<style>
  :root {
    --background: #f4f3ee;
    --surface: #ffffff;
    --surface-elev: #faf9f5;
    --border: #e8e6df;
    --border-hover: #d6d3c9;
    --text: #121316;
    --text-secondary: #5f6368;
    --muted: #8a8f98;
    --primary: #121316;
    --secondary: #faf9f5;
    --accent: #8ca388;
    --accent-hover: #6e876a;
    --accent-strong: #6e876a;
    --sage: #8ca388;
    --brand-red: #d92d20;
    --radius: 1.25rem;
    --shadow-sm: 0 1px 3px 0 rgba(18, 19, 22, 0.06);
    --shadow-md: 0 8px 24px -8px rgba(18, 19, 22, 0.12);
    --shadow-lg: 0 20px 45px -12px rgba(18, 19, 22, 0.10);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Archivo", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    color: var(--text);
    background: var(--background);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    margin: 0.75rem auto 0;
    max-width: 1100px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid var(--border);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-right: 0.75rem;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.6rem 0.6rem 0.6rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }

  .client-portal-link {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .client-portal-link:hover {
    color: var(--text);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--accent);
    text-decoration: none;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
    box-shadow: 0 2px 8px rgba(140, 163, 136, 0.35);
    white-space: nowrap;
  }

  .header-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .header-cta svg {
    flex-shrink: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo-badge {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--brand-red);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(217, 45, 32, 0.3);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-line {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }

  .logo-sub {
    font-weight: 600;
    font-size: 0.55rem;
    letter-spacing: 0.35em;
