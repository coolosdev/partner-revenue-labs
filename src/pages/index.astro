    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
  }

  .auth-submit:hover {
    background: #000000;
    transform: translateY(-1px);
  }

  .auth-fine {
    color: var(--muted);
    font-size: 0.75rem;
