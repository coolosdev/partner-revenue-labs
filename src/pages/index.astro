  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 2.25rem; }
    .section-intro h2,
    .dashboard-preview-content h2,
    .cta-band h2 { font-size: 1.6rem; }
    .hero-visual { grid-template-columns: 1fr; }
    .hero-trust { grid-template-columns: 1fr; }
  }

  /* Responsive auth widget */
  @media (max-width: 640px) {
    .hero h1 { font-size: 2.25rem; }
    .section-intro h2,
    .dashboard-preview-content h2,
    .cta-band h2 { font-size: 1.6rem; }
    .hero-visual { grid-template-columns: 1fr; }
    .hero-trust { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function() {
    // Hero panel mode tabs
    const panelTabs = document.querySelectorAll('.panel-tab');
    const panelViews = document.querySelectorAll('.hero-view');

    if (panelTabs.length && panelViews.length) {
      function setPanelMode(mode: string) {
        panelTabs.forEach(t => {
          const active = t.getAttribute('data-hero-mode') === mode;
          t.classList.toggle('panel-tab--active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panelViews.forEach(v => {
          const active = v.getAttribute('data-hero-view') === mode;
          v.classList.toggle('hero-view--active', active);
        });
      }

      panelTabs.forEach(tab => {
        tab.addEventListener('click', () => setPanelMode(tab.getAttribute('data-hero-mode') || 'dashboard'));
      });

      // Hash handler: /#audit opens the Growth Audit view
      function applyHash() {
        const hash = (location.hash || '').replace('#', '').trim();
        if (hash === 'audit') {
          setPanelMode('form');
        }
      }
      applyHash();
      window.addEventListener('hashchange', applyHash);
    }

    // Hero audit/portal sub-tabs + form submissions
    const auditTabs = document.querySelectorAll<HTMLElement>('[data-audit-tab]');
    const auditPanels = document.querySelectorAll<HTMLElement>('[data-audit-panel]');

    if (auditTabs.length && auditPanels.length) {
      auditTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-audit-tab');
          auditTabs.forEach(t => t.classList.toggle('audit-tab--active', t === tab));
          auditPanels.forEach(p => {
            const show = p.getAttribute('data-audit-panel') === target;
            if (show) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
        });
      });
    }

    const heroAuditForm = document.getElementById('hero-audit-form') as HTMLFormElement | null;
    if (heroAuditForm) {
      heroAuditForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = heroAuditForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const btnSpan = btn?.querySelector('span');
        const statusEl = document.getElementById('hero-audit-status');
        if (btn) btn.disabled = true;
        if (btnSpan) btnSpan.textContent = 'Submitting...';

        const payload = {
          name: (document.getElementById('audit-name') as HTMLInputElement | null)?.value || '',
          email: (document.getElementById('audit-email') as HTMLInputElement | null)?.value || '',
          brandUrl: (document.getElementById('audit-url') as HTMLInputElement | null)?.value || '',
          revenueTier: (document.getElementById('audit-revenue') as HTMLSelectElement | null)?.value || '',
          bottleneck: 'Submitted via hero 48h Audit form',
        };

        try {
          const res = await fetch('/api/qual', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('Request failed');
          if (btnSpan) btnSpan.textContent = 'Audit Request Received ✓';
          if (statusEl) statusEl.textContent = 'Thanks — we will review your store and send a 48-hour bottleneck breakdown.';
          heroAuditForm.reset();
        } catch {
          if (btn) btn.disabled = false;
          if (btnSpan) btnSpan.textContent = 'Request 48-Hour Growth Audit';
          if (statusEl) statusEl.textContent = 'Could not submit right now. Please use the Contact page.';
        }
      });
    }

    const heroPortalForm = document.getElementById('hero-portal-form') as HTMLFormElement | null;
    if (heroPortalForm) {
      heroPortalForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = heroPortalForm.querySelector<HTMLButtonElement>('button[type="submit"]');
        const btnSpan = btn?.querySelector('span');
        const statusEl = document.getElementById('hero-portal-status');
        if (btn) btn.disabled = true;
        if (btnSpan) btnSpan.textContent = 'Sending Request...';

        const email = (document.getElementById('portal-email') as HTMLInputElement | null)?.value || '';
        const brand = (document.getElementById('portal-brand') as HTMLInputElement | null)?.value || '';
        try {
          await fetch('/api/qual', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: 'Client Portal Access Request',
              email,
              brandUrl: brand,
              revenueTier: 'Existing Client',
              bottleneck: 'Requested client reporting dashboard link',
            }),
          });
          if (btnSpan) btnSpan.textContent = 'Request Sent ✓';
          if (statusEl) statusEl.textContent = 'If your brand is active, we will resend your reporting link shortly.';
          heroPortalForm.reset();
        } catch {
          if (btn) btn.disabled = false;
          if (btnSpan) btnSpan.textContent = 'Request Dashboard Link';
          if (statusEl) statusEl.textContent = 'Please email us via the Contact page for your dashboard link.';
        }
      });
    }

    // ROI calculator (conservative planning model)
    const spendSlider = document.getElementById('spend-slider') as HTMLInputElement | null;
    const affiliateSlider = document.getElementById('affiliate-slider') as HTMLInputElement | null;
    const spendVal = document.getElementById('spend-val');
    const affiliateVal = document.getElementById('affiliate-val');
    const projectedRev = document.getElementById('projected-rev');
    const projectedAnnual = document.getElementById('projected-annual');
    const projectedRoas = document.getElementById('projected-roas');
    const projectedTier = document.getElementById('projected-tier');

    if (spendSlider && affiliateSlider && spendVal && affiliateVal && projectedRev) {
      function fmt(n: number) {
        const rounded = Math.round(n);
        if (rounded >= 1000000) return '$' + (rounded / 1000000).toFixed(2) + 'M';
        return '$' + rounded.toLocaleString('en-US');
      }

      function updateCalc() {
        const spend = parseInt(spendSlider!.value, 10);
        const affPct = parseInt(affiliateSlider!.value, 10);

        spendVal!.textContent = '$' + spend.toLocaleString('en-US') + ' / mo';
        affiliateVal!.textContent = affPct + '% of revenue';

        // Conservative planning estimate: 2.6x baseline ROAS, up to 15% lift from untapped creator/affiliate share
        const baseRoas = 2.6;
        const incrementalFactor = 1 + 0.15 * (1 - affPct / 30);
        const monthlyRev = spend * baseRoas * incrementalFactor;
        const annualRev = monthlyRev * 12;

        projectedRev!.textContent = fmt(monthlyRev) + ' / mo';
        if (projectedAnnual) projectedAnnual.textContent = 'Annualized run-rate: ' + fmt(annualRev) + ' / yr';
        if (projectedRoas) projectedRoas.textContent = (monthlyRev / spend).toFixed(2) + 'x';
        if (projectedTier) {
          if (spend <= 20000) projectedTier.textContent = 'Launch (1–2 Channels)';
          else if (spend <= 65000) projectedTier.textContent = 'Scale (2–4 Channels)';
          else projectedTier.textContent = 'Dominate (Omnichannel)';
        }
      }

      updateCalc();
      spendSlider.addEventListener('input', updateCalc);
      affiliateSlider.addEventListener('input', updateCalc);
      (window as any).updateCalc = updateCalc;
    }

    // Auth widget (legacy — kept for compatibility)
    const tabs = document.querySelectorAll('.auth-tab');
    const forms = document.querySelectorAll<HTMLElement>('.auth-form');

    if (tabs.length && forms.length) {
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-auth-tab');
          tabs.forEach(t => t.classList.remove('auth-tab--active'));
          tab.classList.add('auth-tab--active');
          forms.forEach(f => {
            f.style.display = f.getAttribute('data-auth-panel') === target ? 'block' : 'none';
          });
        });
      });

      document.querySelector<HTMLElement>('.auth-tab--active')?.click();

      forms.forEach(form => {
        form.addEventListener('submit', e => {
          e.preventDefault();
          const fine = form.querySelector('.auth-fine');
          const btn = form.querySelector('.auth-submit');
          if (btn) btn.textContent = 'Welcome aboard — check your inbox';
          if (fine) fine.textContent = 'Thanks! This is a demo widget — no data was sent.';
          form.querySelectorAll<HTMLInputElement>('input').forEach(i => { i.value = ''; });
        });
      });
    }
  })();
</script>
