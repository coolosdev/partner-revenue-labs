---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Partner Revenue Labs — Online Marketing Agency";
const description = "We help up-and-coming brands, sponsorships, and brick-and-mortar retailers grow online through advertising packages across social, YouTube, live streaming, and marketplaces — with a dashboard to track every dollar.";
const canonical = "https://partner-revenue-labs.pages.dev/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-content">
          <div class="hero-eyebrow-pill">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>Affiliate, Creator &amp; Performance Marketing</span>
          </div>
          <h1>
            We put your brand in front of the
            <span class="headline-accent">people who buy.
              <svg class="headline-underline" viewBox="0 0 200 8" fill="none" aria-hidden="true"><path d="M1 5.5C40 2 160 2 199 5.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
            </span>
          </h1>
          <p class="hero-subtitle">For emerging brands, sponsorship partners, and brick-and-mortar retailers moving online — we build focused creator &amp; affiliate channels, run disciplined ad spend, and report every dollar without vanity fluff.</p>
          <div class="hero-ctas">
            <a href="/services" class="cta-primary">
              <span>See Our Packages</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="#" data-open-modal="call" class="cta-secondary">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cta-secondary-icon"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Book a Strategy Call</span>
            </a>
          </div>

          <div class="hero-metrics">
            <div class="metric">
              <div class="metric-value">48 Hours</div>
              <div class="metric-label">Channel &amp; Bottleneck Audit</div>
            </div>
            <div class="metric">
              <div class="metric-value metric-value--accent">60–90 Days</div>
              <div class="metric-label">Realistic Channel Ramp</div>
            </div>
            <div class="metric">
              <div class="metric-value">1–2 Core</div>
              <div class="metric-label">Focused Launch Channels</div>
            </div>
          </div>

          <div class="hero-partner-line">
            <span class="partner-dot" aria-hidden="true"></span>
            <span>Supported Platforms: Shopify · Impact.com · Meta &amp; Google · Amazon · Whatnot</span>
          </div>
        </div>

        <div class="hero-panel" id="audit">
          <div class="panel-tabs" role="tablist" aria-label="Hero panel view">
            <button type="button" class="panel-tab panel-tab--active" data-hero-mode="dashboard" role="tab" aria-selected="true">Sample Report</button>
            <button type="button" class="panel-tab" data-hero-mode="form" role="tab" aria-selected="false">48h Audit</button>
            <button type="button" class="panel-tab" data-hero-mode="visual" role="tab" aria-selected="false">Channel Map</button>
          </div>

          <div class="hero-view hero-view--active" data-hero-view="dashboard">
            <div class="glass-card">
              <div class="tel-head">
                <div class="tel-head-left">
                  <div class="tel-badge">PRL</div>
                  <div>
                    <h3 class="tel-title">Client Reporting View
                      <span class="tel-live-tag">Sample</span>
                    </h3>
                    <p class="tel-sub">Illustrative 30-day attribution &amp; spend snapshot</p>
                  </div>
                </div>
                <div class="tel-status">
                  <span class="tel-status-dot"></span>
                  <span>Example Data</span>
                </div>
              </div>

              <div class="tel-stats">
                <div class="tel-stat">
                  <span class="tel-stat-label">30-Day Sample Revenue</span>
                  <div class="tel-stat-value">$38,400</div>
                  <div class="tel-stat-change">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    <span>+14.2% vs prior 30 days</span>
                  </div>
                </div>
                <div class="tel-stat">
                  <span class="tel-stat-label">Sample Blended ROAS</span>
                  <div class="tel-stat-value tel-stat-value--accent">3.15x</div>
                  <div class="tel-stat-note">Typical target: 2.5x–3.5x</div>
                </div>
              </div>

              <div class="tel-chart">
                <div class="tel-chart-head">
                  <span class="tel-chart-title">Illustrative Weekly Revenue Trend</span>
                  <div class="tel-legend">
                    <span><i class="dot dot--sage"></i>Creators &amp; Affiliates</span>
                    <span><i class="dot dot--charcoal"></i>Paid Media</span>
                  </div>
                </div>
                <div class="tel-chart-body">
                  <svg viewBox="0 0 400 100" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                      <linearGradient id="sageGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#8CA388" stop-opacity="0.35"/>
                        <stop offset="100%" stop-color="#8CA388" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    <line x1="0" y1="25" x2="400" y2="25" stroke="#f0efea" stroke-dasharray="3 3"/>
                    <line x1="0" y1="50" x2="400" y2="50" stroke="#f0efea" stroke-dasharray="3 3"/>
                    <line x1="0" y1="75" x2="400" y2="75" stroke="#f0efea" stroke-dasharray="3 3"/>
                    <polygon points="0,95 20,80 60,75 100,60 140,65 180,45 220,50 260,35 300,28 340,32 380,15 400,10 400,100 0,100" fill="url(#sageGrad)"/>
                    <polyline points="0,95 20,80 60,75 100,60 140,65 180,45 220,50 260,35 300,28 340,32 380,15 400,10" fill="none" stroke="#8CA388" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="380" cy="15" r="4" fill="#8CA388" stroke="#ffffff" stroke-width="2"/>
                  </svg>
                </div>
              </div>

              <div class="tel-channels">
                <div class="tel-channels-label">Example Channel Mix (Illustrative)</div>
                <div class="tel-channels-grid">
                  <div class="tel-channel"><span class="tel-channel-name">Creator &amp; Affiliate Partners</span><span class="tel-channel-meta">$16.2k (42%)</span></div>
                  <div class="tel-channel"><span class="tel-channel-name">Paid Social &amp; Search</span><span class="tel-channel-meta">$13.4k (35%)</span></div>
                  <div class="tel-channel"><span class="tel-channel-name">Marketplace Listings</span><span class="tel-channel-meta">$8.8k (23%)</span></div>
                </div>
              </div>

              <div class="tel-ticker">
                <div class="tel-ticker-left">
                  <span class="tel-ticker-dot" aria-hidden="true"></span>
                  <span class="tel-ticker-text"><strong>Sample Event:</strong> $148 order attributed to Creator Partner #12</span>
                </div>
                <span class="tel-ticker-time">Example</span>
              </div>

              <div class="tel-foot">
                <span class="tel-foot-item">
                  <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  Shared GA4 &amp; Looker Studio Reporting
                </span>
                <span class="tel-foot-strong">Illustrative Client View</span>
              </div>
            </div>
          </div>

          <div class="hero-view" data-hero-view="form">
            <div class="glass-card">
              <div class="audit-head">
                <div class="audit-tabs">
                  <button type="button" class="audit-tab audit-tab--active" data-audit-tab="audit">Request Growth Audit</button>
                  <button type="button" class="audit-tab" data-audit-tab="portal">Client Access</button>
                </div>
                <span class="audit-tag">Free 48h Review</span>
              </div>

              <div data-audit-panel="audit">
                <h3 class="audit-title">Audit your funnel &amp; bottlenecks</h3>
                <p class="audit-sub">Get an honest 48-hour review of your conversion leaks, margin headroom, and realistic channel fit.</p>
                <form class="audit-form" id="hero-audit-form" data-audit-form="audit">
                  <div class="audit-field">
                    <label for="audit-revenue">Current Monthly Revenue</label>
                    <select id="audit-revenue">
                      <option>Pre-revenue / Under $20k / month</option>
                      <option selected>$20k - $100k / month (Emerging)</option>
                      <option>$100k - $500k+ / month (Scaling)</option>
                    </select>
                  </div>
                  <div class="audit-row">
                    <div class="audit-field">
                      <label for="audit-name">Full Name</label>
                      <input id="audit-name" type="text" required placeholder="Your name" autocomplete="name" />
                    </div>
                    <div class="audit-field">
                      <label for="audit-email">Work Email</label>
                      <input id="audit-email" type="email" required placeholder="you@brand.com" autocomplete="email" />
                    </div>
                  </div>
                  <div class="audit-field">
                    <label for="audit-url">Brand Website or Store URL</label>
                    <input id="audit-url" type="text" required placeholder="yourbrand.com" />
                  </div>
                  <button type="submit" class="audit-submit">
                    <span>Request 48-Hour Growth Audit</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </button>
                  <p class="audit-assurance" id="hero-audit-status">No obligation · Direct manual review · Zero automated spam</p>
                </form>
              </div>

              <div data-audit-panel="portal" hidden>
                <h3 class="audit-title">Client reporting access</h3>
                <p class="audit-sub">Active clients receive dedicated Looker Studio, GA4, and ad-account links during onboarding.</p>
                <form class="audit-form" id="hero-portal-form" data-audit-form="portal">
                  <div class="audit-field">
                    <label for="portal-email">Client Email</label>
                    <input id="portal-email" type="email" required placeholder="you@brand.com" autocomplete="email" />
                  </div>
                  <div class="audit-field">
                    <label for="portal-brand">Brand Name</label>
                    <input id="portal-brand" type="text" required placeholder="Your brand name" />
                  </div>
                  <button type="submit" class="audit-submit">
                    <span>Request Dashboard Link</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </button>
                  <p class="audit-assurance" id="hero-portal-status">New here? Switch to the Growth Audit tab or <a href="/contact">contact us</a>.</p>
                </form>
              </div>
            </div>
          </div>

          <div class="hero-view" data-hero-view="visual">
            <div class="glass-card">
              <div class="visual-stage">
                <svg class="network-art" viewBox="0 0 400 250" fill="none" aria-hidden="true">
                  <path d="M40 200C100 120 150 180 210 90C260 20 320 70 370 30" stroke="#8CA388" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
                  <path d="M30 90C110 140 170 60 230 140C290 210 340 150 380 190" stroke="#121316" stroke-width="2" stroke-linecap="round" opacity="0.25"/>
                  <path d="M60 40C140 80 200 40 260 90C320 130 360 100 390 120" stroke="#D92D20" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
                  <circle cx="210" cy="90" r="9" fill="#8CA388" opacity="0.85"/>
                  <circle cx="210" cy="90" r="22" fill="#8CA388" opacity="0.18"/>
                  <circle cx="370" cy="30" r="6" fill="#121316" opacity="0.65"/>
                  <circle cx="30" cy="90" r="6" fill="#D92D20" opacity="0.8"/>
                  <circle cx="230" cy="140" r="7" fill="#8CA388" opacity="0.7"/>
                  <circle cx="390" cy="120" r="5" fill="#121316" opacity="0.5"/>
                  <circle cx="60" cy="40" r="5" fill="#D92D20" opacity="0.55"/>
                </svg>
                <div class="visual-overlay visual-overlay--tl">
                  <span class="visual-overlay-label">Focused Launch</span>
                  <span class="visual-overlay-value">1–2 Core Channels First</span>
                </div>
                <div class="visual-overlay visual-overlay--br">
                  <span class="visual-overlay-dot"></span>
                  <span>Target ROAS: 2.5x–3.5x</span>
                </div>
              </div>
              <div class="visual-foot">
                <span>Channel Mix &amp; Attribution Architecture</span>
                <span class="visual-foot-accent">Illustrative Model</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="partner-marquee container" aria-label="Supported ecosystems">
      <div class="partner-marquee-inner">
        <span class="partner-marquee-label">Platforms &amp; sales channels we build campaigns across</span>
        <div class="partner-logos">
          <span class="partner-logo"><i class="partner-logo-dot"></i>SHOPIFY</span>
          <span class="partner-logo partner-logo--wide">IMPACT.COM</span>
          <span class="partner-logo partner-logo--sage">META &amp; GOOGLE ADS</span>
          <span class="partner-logo">AMAZON</span>
          <span class="partner-logo">WHATNOT &amp; TIKTOK</span>
        </div>
      </div>
    </section>

    <section class="roi-section container" id="calculator">
      <div class="roi-intro">
        <span class="roi-eyebrow">Conservative Planning Model</span>
        <h2>Model Realistic Budget &amp; Revenue Scenarios</h2>
        <p>Use conservative ROAS assumptions to sanity-check your monthly media budget before committing spend.</p>
      </div>
      <div class="roi-card">
        <div class="roi-controls">
          <div class="roi-slider">
            <div class="roi-slider-head">
              <label for="spend-slider">Monthly Media &amp; Creator Budget</label>
              <span id="spend-val" class="roi-slider-value">$15,000 / mo</span>
            </div>
            <input type="range" id="spend-slider" min="5000" max="150000" step="5000" value="15000" />
            <div class="roi-slider-ticks"><span>$5k</span><span>$75k</span><span>$150k</span></div>
          </div>
          <div class="roi-slider">
            <div class="roi-slider-head">
              <label for="affiliate-slider">Existing Affiliate &amp; Creator Share</label>
              <span id="affiliate-val" class="roi-slider-value">5% of revenue</span>
            </div>
            <input type="range" id="affiliate-slider" min="0" max="30" step="5" value="5" />
            <div class="roi-slider-ticks"><span>0% (None)</span><span>15% (Early)</span><span>30% (Established)</span></div>
          </div>
          <div class="roi-note">
            <span class="roi-note-title">Planning Caveat (Not a Guarantee):</span>
            <span>Models a conservative 2.6x baseline blended ROAS plus up to 15% lift when building an under-utilized creator/affiliate channel. Actual outcomes depend on product margins (55%+ recommended), site conversion rate, and a 60–90 day testing ramp.</span>
          </div>
        </div>
        <div class="roi-outcome">
          <div class="roi-outcome-label">Estimated Monthly Gross Revenue (Illustrative)</div>
          <div id="projected-rev" class="roi-outcome-value">$43,875 / mo</div>
          <div class="roi-outcome-sub" id="projected-annual">Annualized run-rate: $526,500 / yr</div>
          <div class="roi-outcome-row">
            <span>Modeled Blended ROAS:</span>
            <span id="projected-roas" class="roi-outcome-mono">2.93x</span>
          </div>
          <div class="roi-outcome-row">
            <span>Suggested Starting Tier:</span>
            <span id="projected-tier" class="roi-outcome-mono">Launch (1–2 Channels)</span>
          </div>
<a href="#" data-open-modal="qual" class="roi-cta">
  <span>Stress-Test This With an Audit</span>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
</a>
        </div>
      </div>
    </section>

    <section class="hurdles-section container" id="readiness">
      <div class="section-intro">
        <span class="section-eyebrow">HONEST EXPECTATIONS</span>
        <h2>Real bottlenecks we check before you spend a dollar</h2>
        <p>Paid media and partnerships amplify what is already working — they do not fix broken unit economics or unready operations. Here is what we audit up front.</p>
      </div>
      <div class="hurdles-grid">
        <div class="hurdle-card">
          <span class="hurdle-num">01</span>
          <h3>Margin &amp; AOV Constraints</h3>
          <p>If gross margins are under 50% or AOV is too low to absorb acquisition costs, scaling ad spend loses money. We verify contribution margin before launching.</p>
        </div>
        <div class="hurdle-card">
          <span class="hurdle-num">02</span>
          <h3>Storefront Conversion Leaks</h3>
          <p>Sending paid or creator traffic to a slow product page converting under 1.5% burns budget. We flag checkout, offer, and landing-page friction first.</p>
        </div>
        <div class="hurdle-card">
          <span class="hurdle-num">03</span>
          <h3>60–90 Day Ramp Reality</h3>
          <p>New creator relationships, marketplace rankings, and ad pixels need testing time. Expect structured iteration in months 1–2 before reliable scale in month 3+.</p>
        </div>
        <div class="hurdle-card">
          <span class="hurdle-num">04</span>
          <h3>Inventory &amp; Fulfillment</h3>
          <p>Live shopping (Whatnot / TikTok Live) and retail-to-online launches break down when SKUs stock out or shipping lags. We scope channels to match your ops.</p>
        </div>
      </div>
    </section>

    <section class="channels-section container">
      <div class="section-intro">
        <span class="section-eyebrow">WHERE WE PUT YOUR BRAND</span>
        <h2>Exposure across the channels your customers live in</h2>
        <p>From social feeds to live shopping events and marketplace placements, we meet buyers where they already are.</p>
      </div>
      <div class="channels-grid">
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 3.9"/><path d="m15.4 6.6-6.8 3.9"/></svg>
          </div>
          <h3>Social Media</h3>
          <p>Instagram, TikTok, and X campaigns that build audience, demand, and brand recall.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="4"/><polygon points="10 9 15 12 10 15 10 9"/></svg>
          </div>
          <h3>YouTube</h3>
          <p>Pre-roll, creator integrations, and product features that turn viewers into buyers.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M4.9 19.1a10 10 0 0 1 0-14.2"/><path d="M19.1 4.9a10 10 0 0 1 0 14.2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4"/></svg>
          </div>
          <h3>Live Streaming</h3>
          <p>Twitch, Kick, and TikTok Live activations that drive real-time engagement and sales.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          </div>
          <h3>Whatnot</h3>
          <p>Live shopping events and giveaway drops that convert viewers into repeat buyers.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
          </div>
          <h3>Amazon</h3>
          <p>Sponsored Products, storefronts, and listing optimization that win the buy box.</p>
        </div>
        <div class="channel-card">
          <div class="channel-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><circle cx="7" cy="7" r="1.5"/></svg>
          </div>
          <h3>eBay</h3>
          <p>Marketplace presence and promoted listings that extend your reach beyond your own site.</p>
        </div>
      </div>
    </section>

    <section class="packages-section container">
      <div class="section-intro">
        <span class="section-eyebrow">ADVERTISING PACKAGES</span>
        <h2>Pick a package. We handle the rest.</h2>
        <p>Clear scope, transparent ad spend, and a dashboard that shows exactly where your money goes.</p>
      </div>
      <div class="packages-grid">
        <div class="package-card">
          <h3>Launch</h3>
          <p class="package-for">For up-and-coming brands getting their first real reach.</p>
          <ul>
            <li>2 channels of your choice</li>
            <li>Monthly content calendar</li>
            <li>Campaign setup &amp; management</li>
            <li>Access to the analytics dashboard</li>
          </ul>
          <a href="/services" class="package-cta">Start with Launch</a>
        </div>
        <div class="package-card package-card--featured">
          <span class="package-badge">Most Popular</span>
          <h3>Scale</h3>
          <p class="package-for">For growing brands ready to own their niche across channels.</p>
          <ul>
            <li>4 channels of your choice</li>
            <li>Creator &amp; sponsorship outreach</li>
            <li>Weekly optimization &amp; reporting</li>
            <li>Full dashboard + ad spend tracking</li>
          </ul>
          <a href="/services" class="package-cta">Scale Your Reach</a>
        </div>
        <div class="package-card">
          <h3>Dominate</h3>
          <p class="package-for">For brick-and-mortar retailers building a full online presence.</p>
          <ul>
            <li>All channels, fully managed</li>
            <li>Dedicated account manager</li>
            <li>Custom dashboards &amp; budgets</li>
