    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
  }

  .auth-submit:hover {
    background: #000000;
    transform: translateY(-1px);
  }

  .auth-fine {
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
    margin-top: 0.85rem;
  }

  .auth-social {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
