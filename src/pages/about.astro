---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About — Partner Revenue Labs";
const description = "Partner Revenue Labs is an online marketing agency helping up-and-coming brands, sponsorship partners, and brick-and-mortar retailers build real online reach.";
const canonical = "https://partner-revenue-labs.pages.dev/about";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="about-section">
      <span class="hero-eyebrow">OPERATING PHILOSOPHY</span>
      <h1>Incremental revenue, engineered around unit economics.</h1>
      <p class="intro">Partner Revenue Labs is a performance marketing and partner-growth studio. We help emerging DTC brands, sponsorship partners, and brick-and-mortar retailers capture incremental demand without burning working capital on unattributed vanity metrics.</p>

      <div class="mission-card">
        <h2>Margin-First Growth &amp; Realistic Expectations</h2>
        <p>Most growing brands don't need six channels at once — they need focus and clean unit economics. Paid media cannot rescue thin contribution margins, leaky PDPs, or inventory bottlenecks. We diagnose those constraints up front, launch 1–2 high-fit wedge channels, and track MER, CAC payback, and CAPI/GA4 attribution over a disciplined 60–90 day ramp.</p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 5-6"/></svg>
          </div>
          <h3>Channel-Agnostic</h3>
          <p>We deploy capital where buyer intent actually lives — paid social, creator integrations, live commerce, or retail media — rather than forcing one playbook.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3>Attribution-First</h3>
          <p>Zero black-box reporting. Blended MER, platform ROAS, and channel incrementality live inside shared dashboards updated weekly.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3>Operator-Aligned</h3>
          <p>We diagnose margin, AOV, and checkout friction like an internal growth operator — telling you when not to spend is just as important as scaling.</p>
        </div>
      </div>

      <div class="who-grid">
        <div class="who-card">
          <h3>Emerging DTC Brands</h3>
          <p>You have early product-market fit and healthy gross margin, and need disciplined creative velocity and creator seeding to stabilize CAC.</p>
        </div>
        <div class="who-card">
          <h3>Sponsorship &amp; Creator Partners</h3>
          <p>You want trackable UTMs, whitelisting rights, and live-stream drops that tie creator reach directly to attributed GMV.</p>
        </div>
        <div class="who-card">
          <h3>Retailers Going Omnichannel</h3>
          <p>You have proven in-store demand and catalog depth, and need marketplace Buy Box execution, retail media, and live commerce to scale online.</p>
        </div>
      </div>

      <div class="contact-cta">
        <h2>Ready to stress-test your acquisition funnel?</h2>
        <p>Share your brand URL and margin profile — we'll map the cleanest 1–2 wedge channels to validate first.</p>
        <a href="/contact" class="cta-primary">Book a Discovery Audit</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .about-section {
    padding: 4rem 0;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .about-section h1 {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.1875rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  .mission-card {
    background: var(--surface-elev);
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: var(--radius);
    margin-bottom: 2rem;
  }

  .mission-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .mission-card p {
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 700px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .value-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .value-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 700px) {
    .who-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .who-card {
    background: linear-gradient(160deg, var(--surface-elev), var(--surface));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .who-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .who-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .contact-cta {
    background:
      radial-gradient(circle at 20% 20%, rgba(16, 185, 129, 0.16), transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(212, 43, 43, 0.14), transparent 55%),
      var(--surface);
    border: 1px solid var(--border);
    padding: 2.5rem;
    border-radius: var(--radius);
    text-align: center;
  }

  .contact-cta h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .contact-cta p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .cta-primary {
    display: inline-block;
    background: var(--accent);
    color: var(--primary);
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    background: var(--accent-hover);
  }

  @media (max-width: 640px) {
    .about-section h1 { font-size: 2.1rem; }
  }
</style>
