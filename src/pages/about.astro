---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About — Partner Revenue Labs";
const description = "Partner Revenue Labs is an online marketing agency helping up-and-coming brands, sponsorship partners, and brick-and-mortar retailers build real online reach.";
const canonical = "https://partner-revenue-labs.pages.dev/about";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="about-section">
      <span class="hero-eyebrow">ABOUT THE AGENCY</span>
      <h1>Exposure, engineered end to end.</h1>
      <p class="intro">Partner Revenue Labs is a full-service online marketing agency. We help up-and-coming brands land and maximize deals, partners build sponsorships that perform, and brick-and-mortar retailers step into online reach without guessing.</p>

      <div class="mission-card">
        <h2>Our Mission &amp; Realistic Expectations</h2>
        <p>Most growing brands don't need six channels at once — they need focus and honest unit economics. Traffic cannot fix thin margins, slow product pages, or stockouts. We audit those bottlenecks first, launch 1–2 high-fit channels, and track spend and ROAS cleanly in a shared dashboard over a realistic 60–90 day ramp.</p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 5-6"/></svg>
          </div>
          <h3>Media-Agnostic</h3>
          <p>We go where your buyers are — social feeds, streams, and marketplaces alike — instead of forcing every brand into the same channel.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3>Transparent</h3>
          <p>No black boxes. You see spend, revenue, and ROAS in a shared dashboard, updated as campaigns run.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3>Partner-Minded</h3>
          <p>We work alongside brands, creators, and retailers like an extension of your team — not a vendor you chase.</p>
        </div>
      </div>

      <div class="who-grid">
        <div class="who-card">
          <h3>Up-and-coming brands</h3>
          <p>You have product-market fit and need real exposure. We build the campaign engine and prove the ROI.</p>
        </div>
        <div class="who-card">
          <h3>Sponsorship partners</h3>
          <p>You need activations that deliver — across creators, live streams, and marketplace placements.</p>
        </div>
        <div class="who-card">
          <h3>Brick-and-mortar retailers</h3>
          <p>You have customers and a storefront, but no online reach. We translate in-store success into digital demand.</p>
        </div>
      </div>

      <div class="contact-cta">
        <h2>Ready to build your online reach?</h2>
        <p>Tell us about your brand and where you want to grow — we'll map the fastest path.</p>
        <a href="/contact" class="cta-primary">Book a Free Strategy Call</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .about-section {
    padding: 4rem 0;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .about-section h1 {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.1875rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  .mission-card {
    background: var(--surface-elev);
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: var(--radius);
    margin-bottom: 2rem;
  }

  .mission-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .mission-card p {
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 700px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .value-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .value-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 700px) {
    .who-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .who-card {
    background: linear-gradient(160deg, var(--surface-elev), var(--surface));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .who-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .who-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .contact-cta {
    background:
      radial-gradient(circle at 20% 20%, rgba(16, 185, 129, 0.16), transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(212, 43, 43, 0.14), transparent 55%),
      var(--surface);
    border: 1px solid var(--border);
    padding: 2.5rem;
    border-radius: var(--radius);
    text-align: center;
  }

  .contact-cta h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .contact-cta p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .cta-primary {
    display: inline-block;
    background: var(--accent);
    color: var(--primary);
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    background: var(--accent-hover);
  }

  @media (max-width: 640px) {
    .about-section h1 { font-size: 2.1rem; }
  }
</style>
