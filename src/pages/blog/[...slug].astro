---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, slug: post.slug },
  }));
}

const { post, slug } = Astro.props;
const content = post ? await post.render() : null;
const Content = content ? content.Content : null;
---

<BaseLayout
  title={post?.data.title ?? "Article"}
  description={post?.data.description ?? ""}
  canonical={`https://partner-revenue-labs.pages.dev/blog/${slug}`}
  ogImage={post?.data.heroImage}
>
  <div class="container">
    {post ? (
      <article class="article">
        <header class="article-header">
          <div class="article-meta">
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <time>{post.data.pubDate.toDateString()}</time>
          </div>
          <h1 class="article-title">{post.data.title}</h1>
          <p class="article-excerpt">{post.data.description}</p>
          {post.data.heroImage && (
            <div class="article-hero">
              <img src={post.data.heroImage} alt={post.data.title} loading="eager" />
            </div>
          )}
          <div class="article-author">
            <div class="author-avatar">E</div>
            <div class="author-info">
              <div class="author-name">Partner Revenue Labs</div>
              <div class="author-role">AI Ads & Analytics Resource</div>
            </div>
          </div>
        </header>

        <div class="article-content">
          {Content && <Content />}
        </div>

        <footer class="article-footer">
          <div class="share-section">
            <h3>Share this guide</h3>
            <div class="share-buttons">
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://partner-revenue-labs.pages.dev/blog/${slug}`)}`} target="_blank" rel="noopener" class="share-btn twitter">Share on X</a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://partner-revenue-labs.pages.dev/blog/${slug}`)}`} target="_blank" rel="noopener" class="share-btn linkedin">Share on LinkedIn</a>
            </div>
          </div>

          <div class="cta-box">
            <h3>Want a realistic look at your own stack?</h3>
            <p>Request a free 48-hour growth and bottleneck audit for your store.</p>
            <a href="/contact" class="cta-primary">Request 48h Audit</a>
          </div>
        </footer>
      </article>
    ) : (
      <article class="article">
        <h1>Article not found</h1>
        <p>We couldn't find an article at that path.</p>
        <a href="/blog" class="cta-primary">Back to Blog</a>
      </article>
    )}
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .article {
    padding: 3rem 0;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--surface-elev);
    color: var(--text);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 3rem;
    }
  }

  .article-excerpt {
    font-size: 1.25rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .article-hero {
    margin: 0 0 2rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .article-hero img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    display: block;
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--surface-elev);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .author-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--brand-red));
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .author-name {
    font-weight: 600;
    color: var(--text);
  }

  .author-role {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .article-content {
    color: var(--text);
    line-height: 1.8;
    font-size: 1.125rem;
  }

  .article-content :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .article-content :global(h3) {
    font-size: 1.375rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .article-content :global(p) {
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content :global(a:hover) {
    color: var(--accent-hover);
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .article-content :global(th) {
    background: var(--surface-elev);
    color: var(--text);
    padding: 0.75rem;
    text-align: left;
    font-weight: 600;
  }

  .article-content :global(td) {
    padding: 0.75rem;
    border: 1px solid var(--border);
  }

  .article-content :global(tr:nth-child(even)) {
    background: var(--surface-elev);
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--muted);
  }

  .article-content :global(code) {
    background: var(--surface-elev);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    color: var(--text);
  }

  .article-content :global(pre) {
    background: var(--surface-elev);
    color: var(--text);
    padding: 1.25rem;
    border-radius: var(--radius);
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .share-section {
    margin-bottom: 2rem;
  }

  .share-section h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .share-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .share-btn.twitter {
    background: #000000;
    color: #ffffff;
  }

  .share-btn.twitter:hover {
    background: #333333;
  }

  .share-btn.linkedin {
    background: #0a66c2;
    color: #ffffff;
  }

  .share-btn.linkedin:hover {
    background: #0958a8;
  }

  .cta-box {
    background: linear-gradient(135deg, var(--surface-elev), var(--surface));
    color: var(--text);
    padding: 2rem;
    border-radius: var(--radius);
    text-align: center;
  }

  .cta-box h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .cta-box p {
    opacity: 0.9;
    margin-bottom: 1.25rem;
  }

  .cta-primary {
    display: inline-block;
    background: var(--accent);
    color: var(--primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    box-shadow: var(--shadow-md);
  }

  .cta-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
  }
</style>