---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact — Partner Revenue Labs";
const description = "Book a free strategy call with Partner Revenue Labs. Tell us about your brand and where you want to grow online.";
const canonical = "https://partner-revenue-labs.pages.dev/contact";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="contact-section">
      <span class="hero-eyebrow">LET'S TALK</span>
      <h1>Book a free strategy call</h1>
      <p class="intro">Tell us where you are today — a new brand, a growing store, or a retailer going online — and we'll map the fastest path to reach. No pressure, no jargon.</p>

      <div class="contact-layout">
        <form class="contact-form" id="contact-inquiry-form">
          <div class="field-row">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" placeholder="Your name" required />
            </div>
            <div class="field">
              <label for="email">Work Email</label>
              <input id="email" name="email" type="email" placeholder="you@company.com" required />
            </div>
          </div>
          <div class="field">
            <label for="brand">Brand Website or Store URL</label>
            <input id="brand" name="brand" type="text" placeholder="https://yourbrand.com" required />
          </div>
          <div class="field">
            <label for="type">Where are you today?</label>
            <select id="type" name="type">
              <option>Up-and-coming brand (under $50k/mo)</option>
              <option>Existing online store ($50k–$250k/mo)</option>
              <option>Brick-and-mortar retailer going online</option>
              <option>Sponsorship / creator partnership</option>
            </select>
          </div>
          <div class="field">
            <label for="channels">Primary bottleneck or focus</label>
            <select id="channels" name="channels">
              <option>Not sure yet — audit my funnel first</option>
              <option>Rising Meta / Google CAC — testing creator &amp; affiliate reach</option>
              <option>Storefront conversion rate / margin review before scaling</option>
              <option>Launching Whatnot / TikTok Live shopping</option>
              <option>Expanding onto Amazon / eBay marketplaces</option>
            </select>
          </div>
          <div class="field">
            <label for="message">What are you trying to achieve?</label>
            <textarea id="message" name="message" rows="4" placeholder="Current monthly revenue, rough ad budget, margins, or timeline — anything helpful."></textarea>
          </div>
          <button type="submit" id="contact-submit-btn" class="cta-primary">Send Inquiry</button>
          <p class="form-status" id="contact-form-status" aria-live="polite"></p>
        </form>

        <aside class="contact-aside">
          <div class="aside-card">
            <h2>Book a 15-min call directly</h2>
            <p>Want to talk through your bottlenecks live? Pick a discovery slot with zero obligation.</p>
            <a href="#" data-open-modal="call" class="aside-link">Open Strategy Call Scheduler →</a>
          </div>
          <div class="aside-card">
            <h2>What happens next</h2>
            <ol class="next-list">
              <li>We review your store, margins, and current conversion bottlenecks.</li>
              <li>You get an honest recommendation on the 1–2 channels worth testing first.</li>
              <li>We scope budget, 60–90 day ramp expectations, and shared reporting.</li>
            </ol>
          </div>
          <div class="aside-card">
            <h2>Connect with Partner Revenue Labs</h2>
            <div class="social-links">
              <a href="https://x.com/partnerrevlabs" target="_blank" rel="noopener" class="social-link">X (Twitter)</a>
              <a href="https://www.linkedin.com/company/partner-revenue-labs" target="_blank" rel="noopener" class="social-link">LinkedIn</a>
              <a href="https://www.facebook.com/partnerrevenuelabs" target="_blank" rel="noopener" class="social-link">Facebook</a>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  (function () {
    const form = document.getElementById('contact-inquiry-form') as HTMLFormElement | null;
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
      const statusEl = document.getElementById('contact-form-status');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Sending...';
      }

      const name = (document.getElementById('name') as HTMLInputElement | null)?.value || '';
      const email = (document.getElementById('email') as HTMLInputElement | null)?.value || '';
      const brandUrl = (document.getElementById('brand') as HTMLInputElement | null)?.value || '';
      const revenueTier = (document.getElementById('type') as HTMLSelectElement | null)?.value || '';
      const channelFocus = (document.getElementById('channels') as HTMLSelectElement | null)?.value || '';
      const notes = (document.getElementById('message') as HTMLTextAreaElement | null)?.value || '';

      try {
        const res = await fetch('/api/qual', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            brandUrl,
            revenueTier,
            bottleneck: notes ? `${channelFocus} | Notes: ${notes}` : channelFocus,
          }),
        });
        if (!res.ok) throw new Error('Submission failed');
        if (btn) btn.textContent = 'Inquiry Sent ✓';
        if (statusEl) {
          statusEl.textContent = 'Received! We will review your brand and respond within one business day.';
          statusEl.className = 'form-status form-status--ok';
        }
        form.reset();
      } catch {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Send Inquiry';
        }
        if (statusEl) {
          statusEl.textContent = 'Could not send right now — please try the Strategy Call scheduler on the right.';
          statusEl.className = 'form-status form-status--err';
        }
      }
    });
  })();
</script>

<style>
  .container {
    max-width: 1050px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .contact-section {
    padding: 4rem 0;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .contact-section h1 {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 40rem;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }

  .contact-form {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }

  @media (min-width: 560px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.65rem 0.75rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--text-secondary);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
  }

  .field textarea {
    resize: vertical;
  }

  .cta-primary {
    background: var(--accent);
    color: var(--primary);
    padding: 0.9rem 1.75rem;
    border: none;
    border-radius: var(--radius);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    background: var(--accent-hover);
  }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .aside-card {
    background: var(--surface-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .aside-card h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .aside-card p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  .aside-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .aside-link:hover {
    color: var(--accent-hover);
  }

  .next-list {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .next-list li {
    counter-increment: step;
    position: relative;
    padding-left: 1.9rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .next-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .social-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .social-link:hover {
    color: var(--accent-hover);
  }

  .form-status {
    font-size: 0.85rem;
    line-height: 1.45;
    margin-top: 0.25rem;
  }

  .form-status--ok {
    color: #2f5232;
    font-weight: 600;
  }

  .form-status--err {
    color: var(--brand-red);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .contact-section h1 { font-size: 2.1rem; }
  }
</style>
