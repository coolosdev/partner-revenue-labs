---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const title = "Media Kit";
const description = "Sponsorship & press materials: executive summary, audience metrics, content plan, tech stack, partnerships, and asset download links.";
const canonical = "https://partner-revenue-labs.pages.dev/media-kit";

const posts = await getCollection("blog");
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = sorted.find((p) => p.data.featured) ?? sorted[0];

---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    {featured ? (
      <section class="hero">
        <h1>Sponsorship &amp; Press Kit</h1>
        <p>Agency positioning, audience metrics, channel reach, and asset downloads for press and brand partners.</p>
      </section>
    ) : null}

    <section class="sections">
      <h2>Executive Summary</h2>
      <div class="meta-grid">
        <div class="meta-item">
          <span class="meta-label">Brand Name</span>
          <span class="meta-value">Partner Revenue Labs</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Tagline</span>
          <span class="meta-value">Exposure, engineered end to end.</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Mission</span>
          <span class="meta-value">Help up-and-coming brands, sponsorship partners, and brick-and-mortar retailers build real online reach across social, YouTube, live streaming, and marketplaces.</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Target Niche</span>
          <span class="meta-value">Direct-to-consumer brands, creator partnerships, and retail brands moving from brick-and-mortar to online.</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Core Offering</span>
          <span class="meta-value">Omnichannel advertising packages across social media, YouTube, Twitch/TikTok Live, Whatnot live shopping, Amazon, and eBay — with a shared analytics dashboard.</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Monetization</span>
          <span class="meta-value">Advertising packages (Launch, Scale, Dominate), campaign management fees, and sponsorship activation commissions.</span>
        </div>
      </div>

      <div class="audience-grid">
        <div class="audience-card">
          <h3>Agency Focus &amp; Standards</h3>
          <table class="meta-table">
            <thead><tr><th>Area</th><th>Approach</th></tr></thead>
            <tbody>
              <tr><td>Initial Audit</td><td>48-hour funnel, margin &amp; tracking review</td></tr>
              <tr><td>Launch Scope</td><td>1–2 focused channels before expanding</td></tr>
              <tr><td>Ramp Window</td><td>60–90 day structured testing &amp; iteration</td></tr>
              <tr><td>Reporting</td><td>Shared GA4 &amp; Looker Studio dashboards</td></tr>
              <tr><td>Core Markets</td><td>US DTC brands, creators &amp; retail-to-online</td></tr>
            </tbody>
          </table>
        </div>
        <div class="audience-card">
          <h3>Who We Work Best With</h3>
          <p>Brands with 55%+ gross margins, reliable fulfillment, and realistic expectations around creative testing and attribution. We prefer diagnosing conversion bottlenecks before recommending increased ad spend.</p>
        </div>
      </div>

      <div class="content-strategy">
        <h2>Core Capabilities</h2>
        <ul>
          <li><strong>Channel execution</strong>: social media, YouTube creator integrations, live streaming, Whatnot live shopping, Amazon, and eBay marketplaces.</li>
          <li><strong>Transparent packages</strong>: Launch ($1,500/mo), Scale ($3,500/mo), and Dominate (custom) with clear management scope separate from platform ad spend.</li>
          <li><strong>Shared reporting</strong>: weekly reviews of spend, ROAS, conversion rate, and channel contribution.</li>
          <li><strong>Insights &amp; playbooks</strong>: practical breakdowns of ad tooling, attribution stacks, and retention workflows at <a href="/blog">/blog</a>.</li>
        </ul>
      </div>

      <div class="press-release">
        <h2>Agency Overview</h2>
        <blockquote>
          Partner Revenue Labs helps emerging DTC brands, sponsorship partners, and brick-and-mortar retailers build measurable online sales channels across creator partnerships, social media, live shopping, and marketplaces — grounded in realistic unit economics and transparent reporting.
        </blockquote>
        <p>Media &amp; partnership inquiries: <a href="/contact" class="social-link">Contact Partner Revenue Labs</a></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .sections {
    padding: 3rem 0;
  }

  .hero {
    text-align: center;
    background: linear-gradient(135deg, var(--surface-elev), var(--surface));
    color: var(--text);
    padding: 5rem 2rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: 1.125rem;
    opacity: 0.85;
    max-width: 560px;
    margin: 0 auto;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .meta-item {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem;
    border-radius: var(--radius);
    text-align: left;
  }

  .meta-label {
    font-weight: 700;
    color: var(--text);
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .meta-value {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .audience-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.5rem;
    border-radius: var(--radius);
  }

  .content-strategy ul {
    list-style: none;
    padding-left: 0;
  }

  .content-strategy li {
    padding: 0.75rem 0;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
  }

  .tech-stack table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .tech-stack th,
  .tech-stack td {
    padding: 0.625rem 0.75rem;
    text-align: left;
  }

  .tech-stack th {
    background: var(--surface-elev);
    color: var(--text);
    font-weight: 600;
  }

  .key-diff {
    background: rgba(212, 43, 43, 0.08);
    border: 1px solid rgba(212, 43, 43, 0.25);
    padding: 1.5rem;
    border-radius: var(--radius);
    margin: 2rem 0;
  }

  .partnerships ul {
    padding-left: 1.5rem;
  }

  .assets table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .assets th,
  .assets td {
    padding: 0.625rem 0.75rem;
    text-align: left;
  }

  .assets th {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .press-release blockquote {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--muted);
  }

  .social-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .social-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .social-link:hover {
    color: var(--accent-hover);
  }
</style>