---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy — Partner Revenue Labs";
const description = "How Partner Revenue Labs collects, uses, and protects inquiry, diagnostic audit, and booking data.";
const canonical = "https://partner-revenue-labs.pages.dev/privacy";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="container">
    <section class="legal-section">
      <span class="hero-eyebrow">LEGAL &amp; DATA GOVERNANCE</span>
      <h1>Privacy Policy</h1>
      <p class="legal-meta">Effective Date: November 26, 2026 · Partner Revenue Labs</p>

      <div class="legal-card">
        <h2>1. Information We Collect</h2>
        <p>When you submit a diagnostic audit request, discovery call booking, or inquiry on our site, we collect only the details you provide:</p>
        <ul>
          <li><strong>Contact details:</strong> Name and work email address.</li>
          <li><strong>Business context:</strong> Storefront or brand URL, monthly GMV tier, primary acquisition bottleneck, and optional notes.</li>
          <li><strong>Scheduling metadata:</strong> Requested date/time slot, meeting topic, and browser timezone for calendar invites.</li>
        </ul>
      </div>

      <div class="legal-card">
        <h2>2. How We Use Your Information</h2>
        <ul>
          <li>To prepare your requested 48-hour funnel, margin, or channel audit.</li>
          <li>To schedule and deliver calendar invitations for 15-minute discovery calls.</li>
          <li>To communicate regarding potential or active agency engagements.</li>
        </ul>
        <p>We do <strong>not</strong> sell, rent, or trade your personal or storefront data to third-party data brokers.</p>
      </div>

      <div class="legal-card">
        <h2>3. Storage &amp; Service Providers</h2>
        <p>Form submissions are routed through Cloudflare Pages Functions and stored securely in Cloudflare D1 (SQLite). Where configured, confirmation emails or internal alerts may be dispatched via Resend or private team webhooks. Calendar invitations generated by our scheduler include standard <code>.ics</code> event metadata.</p>
      </div>

      <div class="legal-card">
        <h2>4. Cookies &amp; Analytics</h2>
        <p>This site is built as a lightweight static application without intrusive third-party advertising trackers. Any analytics or conversion pixels added in the future will be reflected in an updated version of this policy.</p>
      </div>

      <div class="legal-card">
        <h2>5. Data Retention &amp; Your Rights</h2>
        <p>We retain inquiry and booking records only as long as necessary to evaluate or service an engagement. You may request access to, correction of, or deletion of your submission data at any time through our <a href="/contact">Contact page</a>.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .legal-section {
    padding: 4rem 0 2rem;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent-strong);
    margin-bottom: 0.85rem;
  }

  .legal-section h1 {
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .legal-meta {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .legal-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    margin-bottom: 1.25rem;
  }

  .legal-card h2 {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .legal-card p,
  .legal-card li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .legal-card p + p,
  .legal-card ul + p {
    margin-top: 0.75rem;
  }

  .legal-card ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .legal-card a {
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-card code {
    background: var(--surface-elev);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
  }

  @media (max-width: 640px) {
    .legal-section h1 { font-size: 2rem; }
    .legal-card { padding: 1.35rem; }
  }
</style>
